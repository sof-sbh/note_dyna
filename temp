
fetch logs, from: toTimestamp("2026-07-23T14:00:00"), to: toTimestamp("2026-07-23T16:41:00")
| filter host.name == "siewbrpl05.ccas.asmeg.org"
| filter loglevel == "ERROR"
| summarize
    access_forbidden = countIf(contains(content, "access forbidden")),
    db_connection_closed = countIf(contains(content, "rollback") or contains(content, "connection has been closed") or contains(content, "no_session") or contains(content, "PGPID:NotConnected")),
    releasing_variables = countIf(contains(content, "Error when releasing variables")),
    timeout = countIf(contains(content, "timeout")),
    autre = countIf(not(contains(content, "access forbidden")) and not(contains(content, "rollback")) and not(contains(content, "connection has been closed")) and not(contains(content, "no_session")) and not(contains(content, "PGPID:NotConnected")) and not(contains(content, "Error when releasing variables")) and not(contains(content, "timeout"))),
    total = count()





